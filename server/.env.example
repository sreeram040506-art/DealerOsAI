DATABASE_URL="mongodb+srv://username:password@cluster0.mongodb.net/dealeros_ai?appName=Cluster0"
# REQUIRED for accurate document extraction. Without it the parser falls back to local
# OCR only, which misreads scanned/photographed bills of sale badly (e.g. reading a phone
# number as the VIN). Must be set in EVERY environment, including production hosting.
OPENAI_API_KEY="sk-..."
PORT=3001
JWT_SECRET="super-secret-key-replace-me"
NODE_ENV=development
CLIENT_URL="http://127.0.0.1:8081,http://localhost:8081"
VITE_API_ORIGIN="http://127.0.0.1:3001"