DATABASE_URL="mongodb+srv://username:password@cluster0.mongodb.net/dealeros_ai?appName=Cluster0"
# REQUIRED for accurate document extraction. Without it the parser falls back to local
# OCR only, which misreads scanned/photographed bills of sale badly (e.g. reading a phone
# number as the VIN). Must be set in EVERY environment, including production hosting.
OPENAI_API_KEY="sk-..."
PORT=3001
# REQUIRED in production. Signs and verifies every login token — the server refuses to
# start in production without it rather than falling back to a guessable value.
JWT_SECRET="super-secret-key-replace-me"
# REQUIRED in production. The server creates/repairs two SUPER_ADMIN accounts on every boot
# (indra@indraam.com, sreeram@indraam.com) and refuses to do so in production without this
# set, rather than using a guessable default password.
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
# REQUIRED to save per-dealership integration credentials (Facebook, SendGrid, Twilio, Slack,
# OpenAI). They are encrypted with this key; changing it makes saved credentials unreadable.
# Generate one with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY="replace-with-64-hex-characters"
# Facebook, SendGrid, Twilio and Slack are configured per dealership in Settings, not here.
# OPENAI_API_KEY above is the platform fallback for dealerships without their own key.
NODE_ENV=development
CLIENT_URL="http://127.0.0.1:8081,http://localhost:8081"
VITE_API_ORIGIN="http://127.0.0.1:3001"
